{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herdr.invalid/schema/host-config-v1.json",
  "title": "Herdr relay host configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hosts"],
  "properties": {
    "schema_version": {"const": 1},
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "project_roots", "herdr", "harnesses", "power", "readiness_timeout_seconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
          "ssh": {
            "type": "object",
            "additionalProperties": false,
            "properties": {"target": {"type": "string", "minLength": 1, "maxLength": 256}}
          },
          "project_roots": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^/", "maxLength": 4096}
          },
          "herdr": {
            "type": "object",
            "additionalProperties": false,
            "required": ["wrapper"],
            "properties": {
              "binary": {"type": "string", "minLength": 1, "maxLength": 4096},
              "wrapper": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
            }
          },
          "harnesses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "display_name"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
                "enabled": {"type": "boolean"},
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1, "maxLength": 4096}
                },
                "model_aliases": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id"],
                        "properties": {
                          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                          "display_name": {"type": "string", "minLength": 1, "maxLength": 128}
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "power": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shutdown"],
            "properties": {
              "wake": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["mac"],
                "properties": {"mac": {"type": "string", "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$"}}
              },
              "shutdown": {"type": "boolean"}
            }
          },
          "readiness_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "power": {
                  "properties": {"shutdown": {"const": true}}
                }
              }
            },
            "then": {
              "required": ["ssh"],
              "properties": {
                "ssh": {"required": ["target"]}
              }
            }
          }
        ]
      }
    }
  }
}
